<Window xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    x:Class="XboxCsMgr.Client.Dialogue"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    WindowStartupLocation="CenterScreen" 
    SizeToContent="WidthAndHeight"
    MinWidth="300"
    MinHeight="100"
    WindowStyle="SingleBorderWindow"
    ResizeMode="NoResize">
    <StackPanel Margin="5">
        <TextBlock x:Name="txtQuestion"/>
        <StackPanel Orientation="Horizontal" Margin="5" HorizontalAlignment="Right"/>
        <Button Content="Open Link" Click="Button_Click_2"/>
        <TextBlock Height="12"/>
        <Grid>

            <Button Content="Done!" Click="Button_Click" Width="81" Margin="60,0,149,0"/>
            <Button Content="Exit" Click="Button_Click" Width="81" Margin="149,0,60,0"/>
        </Grid>

    </StackPanel>
</Window>
